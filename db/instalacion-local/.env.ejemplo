# ---------------------------------------------------------------------------
# Suite Empresarial BP Dominicana — configuración de una instalación local
# Copie este archivo como ".env" y complete los valores. No lo comparta.
# ---------------------------------------------------------------------------

# --- Base de datos del cliente (MariaDB / MySQL) ---------------------------
MYSQL_HOST=192.168.1.10
MYSQL_PORT=3306
MYSQL_DATABASE=nombre_de_la_base
MYSQL_USER=usuario
MYSQL_PASSWORD=clave
MYSQL_SSL=false

# --- Opcional: puente HTTPS (solo si la app no alcanza el puerto de MySQL) --
# MYSQL_BRIDGE_URL=https://sudominio.com/erp/puente-mysql.php
# MYSQL_BRIDGE_TOKEN=clave-del-puente

# --- Sesión ----------------------------------------------------------------
# Cadena larga y aleatoria, distinta en cada instalación.
SESSION_SECRET=cambie-esto-por-una-cadena-larga-y-aleatoria

# --- Licenciamiento (lo entrega BP Dominicana) -----------------------------
# Dirección del servidor de licencias de BP Dominicana:
LICENSE_SERVER_URL=https://erp.bpdominicana.com/api/public/licencia
# Clave única de esta instalación (formato BPD-XXXXXXXX-XXXXXXXX-XXXXXXXX-XXXXXXXX):
LICENSE_KEY=BPD-00000000-00000000-00000000-00000000
# Clave pública de BP Dominicana (verifica la firma; es pública, no es secreta):
LICENSE_PUBLIC_KEY=MCowBQYDK2VwAyEAIsJTFtvD+lbVQHFGiY5jUjKNmqsFAkfeFRmQSWySBoM=
# Versión reportada al servidor de licencias:
APP_VERSION=local-1.0

# IMPORTANTE: LICENSE_PRIVATE_KEY nunca se instala en el cliente.
# Solo vive en el servidor de licencias de BP Dominicana.
